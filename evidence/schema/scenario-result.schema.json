{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-ops-showcase.tatics.de/schema/scenario-result.json",
  "title": "Scenario result",
  "description": "Structured result document of one demo run (local or CI).",
  "type": "object",
  "required": [
    "scenario_id",
    "scenario_name",
    "execution_mode",
    "status",
    "started_at",
    "completed_at",
    "checks",
    "limitations"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string" },
    "scenario_id": { "type": "string", "minLength": 3 },
    "scenario_name": { "type": "string", "minLength": 3 },
    "kind": { "type": "string", "enum": ["lab", "scripted-pipeline"] },
    "execution_mode": { "type": "string", "enum": ["local", "live-ci", "replay"] },
    "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
    "started_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "completed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "commit": { "type": ["string", "null"] },
    "workflow_run": { "type": ["string", "null"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
          "detail": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
